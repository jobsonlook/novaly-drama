# Chrome CDP 调试端口基址（并行 worker 使用 9222、9223…）
DOUBAO_CDP_URL=http://127.0.0.1:9222
DOUBAO_CDP_PORT=9222

# 最大并行视频路数（每路一个 Chrome + 账号；默认 2）
# MAX_PARALLEL_VIDEO=2

# Chrome 用户数据目录（无账号池 / 未显式传入 session 时使用）
# 示例：./session（默认）、./session/ba、./session/ma
DOUBAO_SESSION_DIR=./session

# 多账号 SQLite 与当前 session 文件（管理后台 /admin）
# DOUBAO_ACCOUNTS_DB=./data/accounts.db
# DOUBAO_ACTIVE_SESSION_FILE=./data/active_session
# DOUBAO_CHROME_SCRIPT=./scripts/start-chrome.sh
# 启动服务时自动预热 worker Chrome（默认开启；设为 0 关闭）
# DOUBAO_AUTO_RESTART_CHROME=1

# HTTP 服务端口
PORT=8080

# 可选 API 鉴权（留空则不校验；设置后 /admin 也需 Bearer 或 ?key=）
# DOUBAO_API_KEY=your-secret

# 文生图请求超时（秒）
REQUEST_TIMEOUT=120

# 图生视频请求超时（秒）
# Seedance queue often ~15m; leave headroom for generation + URL recovery.
VIDEO_TIMEOUT=1500

# 视频 UI 模式：skill=普通「视频生成」技能（默认），office=办公任务 Turbo
VIDEO_UI_MODE=skill

# 腾讯云 COS：视频生成成功后直传，task.video_url 返回 COS 公网地址（留空则仍走 proxy）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=novaly-1258504407
# COS_REGION=ap-shanghai
# COS_ACCELERATE=true
# COS_PUBLIC_BASE_URL=
# COS_KEY_PREFIX=doubao-web/videos
